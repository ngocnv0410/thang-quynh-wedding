{
  "name": "thang-quynh-wedding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "review:ui": "node scripts/capture-review.mjs",
    "test:all": "npm test && npm run test:ui",
    "gift:qr": "node scripts/generate-gift-qr.mjs",
    "pretest": "npm run gift:qr",
    "prebuild": "npm run gift:qr",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-thang-quynh \"node scripts/test-firebase.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "firebase-tools": "^15.34.2",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "firebase": "^13.1.0"
  }
}
